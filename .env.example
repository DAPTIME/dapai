# Environment variables this app reads. Copy the names, not the values.
#
# IMPORTANT: .env is tracked in git in this repository. Anything written
# there is committed and pushed. The publishable/anon key below is safe to
# commit — it is designed to be shipped to browsers and is protected by
# row-level security. The service role key is NOT: it bypasses RLS
# entirely and is equivalent to full database access. Set that one in the
# hosting environment's variables/secrets, never in this file.


# ── Supabase, browser ───────────────────────────────────────────────────
# Read by src/integrations/supabase/client.ts at build time. Safe to
# commit; the anon key is public by design.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# ── Supabase, server ────────────────────────────────────────────────────
# Read by src/integrations/supabase/client.server.ts and the auth
# middleware. SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY mirror the two
# above and must point at the same project, or the browser and the server
# end up talking to different databases.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon key>

# Supabase dashboard → Project Settings → API → service_role.
# SECRET. Bypasses row-level security. Set this in the hosting
# environment, not here. Without it every server function that touches
# supabaseAdmin throws — chat, profile updates, account recovery, the
# admin page, the free-try endpoint and the chat cleanup hook.
SUPABASE_SERVICE_ROLE_KEY=<service_role key — hosting env only>

# ── Model backends ──────────────────────────────────────────────────────
AI_BACKEND_URL=
AI_BACKEND_KEY=
AI_BACKEND_URL_LITE=
AI_BACKEND_KEY_LITE=
AI_BACKEND_MODEL_LITE=
AI_BACKEND_URL_PRO=
AI_BACKEND_KEY_PRO=
AI_BACKEND_MODEL_PRO=

# ── Optional ────────────────────────────────────────────────────────────
SITE_URL=https://dapai.lovable.app
LOVABLE_API_KEY=
STRIPE_SECRET_KEY=
FIRECRAWL_API_KEY=
DATABASE_URL=
