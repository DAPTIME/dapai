{
  "name": "DAP Games",
  "short_name": "DAP Games",
  "description": "DAP Games is a free browser arcade — 2048, Snake, DAP Track 3D time trials, River Crosser, Flappy, Brick Breaker and more, playable instantly with no download.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#090d15",
  "theme_color": "#090d15",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Games", "short_name": "Games", "url": "/games", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "DAP Track", "short_name": "DAP Track", "url": "/games/daptrack", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
